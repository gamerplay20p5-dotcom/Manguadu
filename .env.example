# ============================================================
# FRIENDHOST - PZ/BOT - CONFIGURACAO INICIAL
# ============================================================
# Copie este arquivo para .env na VM e preencha os campos obrigatorios.
# Nunca envie o arquivo .env real para o GitHub ou para outras pessoas.
# Campos marcados como AUTOMATICO ou OPCIONAL podem ficar vazios.

# ============================================================
# DISCORD - OBRIGATORIO
# Portal: https://discord.com/developers/applications
# ============================================================

# Token secreto do bot.
# Onde pegar: sua aplicacao > Bot > Reset Token/Copy.
DISCORD_TOKEN=

# ID da aplicacao do bot.
# Onde pegar: sua aplicacao > General Information > Application ID.
DISCORD_CLIENT_ID=

# ID do seu servidor Discord. Faz os slash commands aparecerem imediatamente.
# Ative o Modo Desenvolvedor no Discord, clique com o botao direito no servidor
# e escolha "Copiar ID do servidor".
GUILD_ID=

# ============================================================
# CANAIS DO DISCORD
# Para copiar IDs: Configuracoes > Avancado > Modo Desenvolvedor.
# Depois clique com o botao direito no canal > Copiar ID do canal.
# ============================================================

# Canal que recebe notificacoes administrativas e de atualizacao do bot.
ID_CANAL_ADMIN=

# Canal usado para espelhar o chat do Project Zomboid.
ID_CANAL_CHAT=

# Canal que recebe avisos de evolucao de skills/perks dos jogadores.
ID_CANAL_EVOLUCAO=

# Canal onde o bot publica/atualiza o painel de status do servidor.
ID_CANAL_STATS=

# Canal onde o bot publica/atualiza o ranking dos jogadores.
ID_CANAL_RANKING=

# ============================================================
# ARQUIVOS DO PROJECT ZOMBOID - AUTOMATICO
# Normalmente deixe estes campos como estao.
# O bot procura Zomboid/Lua e completa os campos vazios no .env da VM.
# Valores preenchidos manualmente nunca sao substituidos.
# ============================================================

# 1 = procurar caminhos automaticamente; 0 = usar apenas caminhos manuais.
PZ_AUTO_DISCOVER_PATHS=1

# OPCIONAL: pasta Zomboid/Lua deste servidor.
# Use somente se a VM possuir mais de uma instalacao. Ex.: /root/Zomboid/Lua
# Em Wings/Pterodactyl pode ser algo como:
# /var/lib/pterodactyl/volumes/UUID/.cache/Lua
PZ_LUA_PATH=

# AUTOMATICO: raiz local do PZ na VM.
# Ex.: /var/lib/pterodactyl/volumes/UUID/.cache
PZ_CACHE_ROOT=

# OPCIONAL: raizes extras para procurar, separadas por virgula.
# Ex.: /root,/home/container,/meu/caminho
PZ_PATH_SCAN_ROOTS=

# AUTOMATICO: pasta que contem FriendHost_Data/Jogadores e Servidor.
CSV_BASE_PATH=

# LEGADO/OPCIONAL: caminho de arquivos TXT de integracoes antigas.
# Atualmente pode ficar vazio.
TXT_BASE_PATH=

# AUTOMATICO: pasta de logs do Project Zomboid.
LOGS_PATH=

# OPCIONAL: webhook de um canal Discord para espelhar o chat com nome/avatar.
# Onde criar: Editar canal > Integracoes > Webhooks > Novo Webhook > Copiar URL.
# Deixe vazio se nao quiser o espelho por webhook.
WEBHOOK_CHAT=

# ============================================================
# MAPAS E WIPES
# ============================================================

# OPCIONAL: endereco exibido aos jogadores no painel.
# Ex.: connect.seuservidor.com:16261
SERVER_CONNECT_ADDRESS=

# OPCIONAL: limite de jogadores exibido no painel. Ex.: 32
SERVER_MAX_SLOTS=

# OPCIONAL: caminho para o JSON de mapas.
# Vazio usa config/pz-maps.json dentro do projeto.
PZ_MAPS_CONFIG_PATH=

# AUTOMATICO: caminho do save visto pelo bot.
# O bot encontra o unico save em Saves/Multiplayer. Preencha apenas para forcar.
# Pode ser local na VM: /var/lib/pterodactyl/volumes/UUID/.cache/Saves/Multiplayer/servertest
# Ou via API do painel: /.cache/Saves/Multiplayer/servertest
PZ_SAVE_ROOT=

# Tempo maximo, em milissegundos, para aguardar o backup antes de um wipe.
# 600000 = 10 minutos.
PZ_WIPE_BACKUP_WAIT_MS=600000

# OPCIONAL: onde guardar backups locais antes de wipes quando o painel cair.
# Vazio usa data/local-wipe-backups dentro do bot.
PZ_LOCAL_BACKUP_DIR=

# ============================================================
# PZ ANTICHEAT
# ============================================================

# 1 = enviar alertas do mod; 0 = desativar os alertas.
ANTICHEAT_ALERTS_ENABLED=1

# AUTOMATICO: caminho local do CSV criado pelo mod em Zomboid/Lua.
ANTICHEAT_CSV_PATH=

# AUTOMATICO: caminho do mesmo CSV visto pelo Pterodactyl.
# Usado quando o bot nao consegue acessar o arquivo local da VM.
ANTICHEAT_PTERO_CSV_PATH=

# OPCIONAL: canal exclusivo para alertas do anticheat.
# Vazio usa ID_CANAL_ADMIN.
ANTICHEAT_ALERT_CHANNEL_ID=

# Intervalo de leitura do CSV, em milissegundos. 15000 = 15 segundos.
ANTICHEAT_POLL_INTERVAL_MS=15000

# Quantidade maxima de deteccoes detalhadas em uma unica mensagem.
# As restantes sao apenas contabilizadas no resumo. Maximo permitido: 25.
ANTICHEAT_MAX_ALERTS_PER_TICK=10

# Ignora registros mais antigos que este limite. 10 = ultimos 10 minutos.
# Use 0 somente se quiser aceitar registros antigos.
ANTICHEAT_MAX_ALERT_AGE_MINUTES=10

# Tempo minimo para avisar novamente sobre o mesmo jogador e tipo de cheat.
# Repeticoes durante esse periodo sao descartadas para evitar flood.
ANTICHEAT_ALERT_COOLDOWN_MINUTES=10

# 1 = ao instalar o bot sem estado salvo, trata o CSV atual como historico.
# Isso impede que registros antigos sejam enviados na primeira inicializacao.
ANTICHEAT_IGNORE_EXISTING_ON_START=1

# Fuso usado para interpretar timestamps do CSV que nao possuem UTC/offset.
# Vazio reutiliza AUTOMATION_TIMEZONE.
ANTICHEAT_TIMEZONE=

# 1 = limpar alertas processados do pending; 0 = manter o arquivo intacto.
ANTICHEAT_CLEAR_PENDING=1

# ============================================================
# PTERODACTYL - OBRIGATORIO PARA PAINEL, BACKUPS E WIPES
# ============================================================

# URL principal do seu painel, sem /api no final.
# Ex.: https://painel.seuservidor.com
PTERO_URL=

# Identificador do servidor no Pterodactyl.
# Abra o servidor no painel: normalmente e o codigo depois de /server/ na URL.
# Tambem aparece na pagina Settings do servidor como Server ID/Identifier.
PTERO_SERVER_ID=

# AUTOMATICO/OPCIONAL: UUID completo do volume/container do Wings.
# O bot tenta descobrir por /var/lib/pterodactyl/volumes/UUID.
PTERO_VOLUME_ID=

# OPCIONAL: UUID completo do servidor no Wings, se diferente do volume.
PTERO_SERVER_UUID=

# OPCIONAL: nome ou ID do container Docker.
# Preencha se a VM tiver varios containers e a descoberta ficar ambigua.
PTERO_DOCKER_CONTAINER=

# 1 = se o painel cair, tentar restart/stop/start e status via Docker local.
# 0 = depender somente da API do Pterodactyl.
PTERO_LOCAL_FALLBACK_ENABLED=1

# Chave Client API da conta que possui acesso ao servidor.
# Onde criar: Pterodactyl > Account/Conta > API Credentials > Create API Key.
# Use uma conta restrita somente ao servidor que este bot administrara.
PTERO_API_KEY=

# OPCIONAL: arquivos/pastas que o Pterodactyl deve ignorar nos backups do bot.
# Deixe vazio para incluir tudo.
PTERO_BACKUP_IGNORED=

# ============================================================
# RCON - OPCIONAL
# O bot usa o console do Pterodactyl quando RCON nao estiver configurado.
# ============================================================

# IP/host acessivel pela VM. Ex.: 127.0.0.1
RCON_HOST=127.0.0.1

# Porta RCON configurada no servidor Project Zomboid.
RCON_PORT=27015

# Senha RCON configurada no Project Zomboid.
RCON_PASSWORD=

# OPCIONAL: chave estavel para cifrar senhas de WL durante revisao.
# Se vazia, o bot deriva uma chave do DISCORD_TOKEN. Ao trocar o token, senhas
# de pedidos pendentes so continuarao legiveis se esta chave estiver definida.
WL_ENCRYPTION_KEY=

# ============================================================
# AUTOMACOES DO SERVIDOR
# ============================================================

# Fuso usado pelos horarios das automacoes.
AUTOMATION_TIMEZONE=America/Sao_Paulo

# OPCIONAL: fuso geral do processo Python/Linux.
# Vazio usa AUTOMATION_TIMEZONE para as automacoes.
TZ=

# Quantos minutos atrasada uma tarefa ainda pode executar.
AUTOMATION_GRACE_MINUTES=5

# ============================================================
# ATUALIZACAO DO BOT NA VM
# ============================================================

# Nome exato do processo mostrado por: pm2 list
PM2_APP_NAME=friendhost-pz-bot

# O processo do PM2 deve executar: python -m manguadu --bot
BOT_PM2_RUNTIME=python

# Branch que a VM deve baixar. Use main depois que as alteracoes forem mescladas.
BOT_UPDATE_BRANCH=migration/python-runtime

# 1 = verificar atualizacoes automaticamente; 0 = somente /bot atualizar.
BOT_AUTO_UPDATE_ENABLED=0

# Intervalo entre verificacoes, em milissegundos. Minimo: 60000.
# 120000 = 2 minutos.
BOT_AUTO_UPDATE_INTERVAL_MS=120000

# Tempo maximo da atualizacao completa. 300000 = 5 minutos.
BOT_UPDATE_TIMEOUT_MS=300000

# OPCIONAL: deixe vazio quando o repositorio for publico.
# Para repositorio privado, use um fine-grained token limitado ao repositorio
# com permissao Contents: Read-only. Guarde o token apenas no .env da VM.
BOT_GITHUB_TOKEN=

# OPCIONAL: caminho do executavel PM2. Vazio usa o comando "pm2" do sistema.
PM2_BIN=
